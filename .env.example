# P1 has no secrets. This file documents every knob the storage layer reads.
# Copy to .env only if you are switching the lake to an S3-compatible service.

# --- default: local filesystem, no cloud, no cost ---
DE_LAKE_ROOT=./lake

# --- switch to S3 / Cloudflare R2 / MinIO / Garage ---
# Setting DE_LAKE_S3_BUCKET is the ONLY switch that changes the sink. No code
# changes, no import changes. All four services speak the S3 API.
# DE_LAKE_S3_BUCKET=de-lake
# DE_LAKE_S3_ENDPOINT=http://localhost:9000      # omit for AWS S3
# DE_LAKE_S3_ACCESS_KEY=
# DE_LAKE_S3_SECRET_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- SEC identification (not a secret) ---
# SEC requires a contactable party in the User-Agent and throttles requests
# without one. Hardcoded in src/de_lake/settings.py; listed here for visibility.
# SEC_USER_AGENT=DataEngineeringPortfolio/0.1 (you@example.com)